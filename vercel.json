{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "includeFiles": "{assets/**,public/**,node_modules/pdfjs-dist/legacy/build/pdf.worker.mjs}"
    },
    "src/server.ts": {
      "includeFiles": "{assets/**,public/**,node_modules/pdfjs-dist/legacy/build/pdf.worker.mjs}"
    }
  },
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "/api?__url=/:path*"
    }
  ]
}
